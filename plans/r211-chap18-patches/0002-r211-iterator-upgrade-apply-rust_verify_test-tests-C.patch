+++ b/rust_verify_test/tests/Chap18/ProveArraySeqMtEph.rs
@@ -17,35 +17,35 @@ use common::*;
 test_verify_one_file! {
     #[test] arrayseqmteph_loop_loop verus_code! {
         use vstd::prelude::*;
+        use vstd::std_specs::iter::*;
         use apas_verus::Chap18::ArraySeqMtEph::ArraySeqMtEph::*;
         
         fn test_loop_loop() {
             let a: ArraySeqMtEphS<u64> = ArraySeqMtEphS::new(3, 42);
             
-            let mut it: ArraySeqMtEphIter<u64> = a.iter();
-            let ghost iter_seq: Seq<u64> = it@.1;
-            let ghost mut items: Seq<u64> = Seq::empty();
-            
-            #[verifier::loop_isolation(false)]
+            let ghost orig: Seq<u64> = a.seq@;
+            let mut collected: Vec<u64> = Vec::new();
+            let mut it: VerusForLoopWrapper<std::slice::Iter<'_, u64>> =
+                VerusForLoopWrapper::new(a.iter());
             loop
                 invariant
-                    items =~= iter_seq.take(it@.0 as int),
-                    iter_invariant(&it),
-                    iter_seq == it@.1,
-                    it@.0 <= iter_seq.len(),
-                decreases iter_seq.len() - it@.0,
+                    it.wf(),
+                    IteratorSpec::obeys_prophetic_iter_laws(&it.iter),
+                    IteratorSpec::decrease(&it.iter) is Some,
+                    it.seq() == orig.as_ref(),
+                    collected.len() == it.index(),
+                    forall|i: int| 0 <= i < collected.len()
+                        ==> #[trigger] collected@[i] == *it.seq()[i],
+                decreases IteratorSpec::decrease(&it.iter)->0,
             {
-                if let Some(x) = it.next() {
-                    proof {
-                        items = items.push(*x);
-                    }
-                } else {
-                    break;
+                match it.next() {
+                    Some(x) => { collected.push(*x); },
+                    None => {
+                        assert(collected@ =~= orig);
+                        break;
+                    },
                 }
             }
-            
-            assert(it@.0 == iter_seq.len());
-            assert(items =~= iter_seq);
         }
     } => Ok(())
 }
