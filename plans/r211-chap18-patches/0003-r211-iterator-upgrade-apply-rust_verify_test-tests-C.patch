 .../tests/Chap18/ProveArraySeqMtEphSlice.rs   | 114 +++++++++---------
 1 file changed, 58 insertions(+), 56 deletions(-)

diff --git a/rust_verify_test/tests/Chap18/ProveArraySeqMtEphSlice.rs b/rust_verify_test/tests/Chap18/ProveArraySeqMtEphSlice.rs
index 89e11d8..b78fc08 100644
--- a/rust_verify_test/tests/Chap18/ProveArraySeqMtEphSlice.rs
+++ b/rust_verify_test/tests/Chap18/ProveArraySeqMtEphSlice.rs
@@ -19,33 +19,35 @@ use common::*;
 test_verify_one_file! {
     #[test] chap18_arrayseqmtephslice_loop_borrow_iter verus_code! {
         use vstd::prelude::*;
+        use vstd::std_specs::iter::*;
         use apas_verus::Chap18::ArraySeqMtEphSlice::ArraySeqMtEphSlice::*;
 
         fn test_loop_borrow_iter() {
             let a: ArraySeqMtEphSliceS<u64> = ArraySeqMtEphSliceS::new(3, 42);
 
-            let mut it: ArraySeqMtEphSliceIter<'_, u64> = a.iter();
-            let ghost iter_seq: Seq<u64> = it@.1;
-            let ghost mut items: Seq<u64> = Seq::empty();
-
-            #[verifier::loop_isolation(false)]
+            let ghost orig: Seq<u64> = a.spec_backing_seq();
+            let mut collected: Vec<u64> = Vec::new();
+            let mut it: VerusForLoopWrapper<std::slice::Iter<'_, u64>> =
+                VerusForLoopWrapper::new(a.iter());
             loop
                 invariant
-                    items =~= iter_seq.take(it@.0 as int),
-                    iter_invariant(&it),
-                    iter_seq == it@.1,
-                    it@.0 <= iter_seq.len(),
-                decreases iter_seq.len() - it@.0,
+                    it.wf(),
+                    IteratorSpec::obeys_prophetic_iter_laws(&it.iter),
+                    IteratorSpec::decrease(&it.iter) is Some,
+                    it.seq() == orig.as_ref(),
+                    collected.len() == it.index(),
+                    forall|i: int| 0 <= i < collected.len()
+                        ==> #[trigger] collected@[i] == *it.seq()[i],
+                decreases IteratorSpec::decrease(&it.iter)->0,
             {
-                if let Some(x) = it.next() {
-                    proof { items = items.push(*x); }
-                } else {
-                    break;
+                match it.next() {
+                    Some(x) => { collected.push(*x); },
+                    None => {
+                        assert(collected@ =~= orig);
+                        break;
+                    },
                 }
             }
-
-            assert(it@.0 == iter_seq.len());
-            assert(items =~= iter_seq);
         }
     } => Ok(())
 }
