 .../tests/Chap18/ProveArraySeqStPer.rs        | 61 +++++++++----------
 1 file changed, 29 insertions(+), 32 deletions(-)

diff --git a/rust_verify_test/tests/Chap18/ProveArraySeqStPer.rs b/rust_verify_test/tests/Chap18/ProveArraySeqStPer.rs
index 4615fb7..eacb753 100644
--- a/rust_verify_test/tests/Chap18/ProveArraySeqStPer.rs
+++ b/rust_verify_test/tests/Chap18/ProveArraySeqStPer.rs
@@ -16,35 +16,35 @@ use common::*;
 test_verify_one_file! {
     #[test] arrayseqstper_loop_loop verus_code! {
         use vstd::prelude::*;
+        use vstd::std_specs::iter::*;
         use apas_verus::Chap18::ArraySeqStPer::ArraySeqStPer::*;
         
         fn test_loop_loop() {
             let a: ArraySeqStPerS<u64> = ArraySeqStPerS::new(3, 42);
             
-            let mut it: ArraySeqStPerIter<u64> = a.iter();
-            let ghost iter_seq: Seq<u64> = it@.1;
-            let ghost mut items: Seq<u64> = Seq::empty();
-            
-            #[verifier::loop_isolation(false)]
+            let ghost orig: Seq<u64> = a.seq@;
+            let mut collected: Vec<u64> = Vec::new();
+            let mut it: VerusForLoopWrapper<std::slice::Iter<'_, u64>> =
+                VerusForLoopWrapper::new(a.iter());
             loop
                 invariant
-                    items =~= iter_seq.take(it@.0 as int),
-                    iter_invariant(&it),
-                    iter_seq == it@.1,
-                    it@.0 <= iter_seq.len(),
-                decreases iter_seq.len() - it@.0,
+                    it.wf(),
+                    IteratorSpec::obeys_prophetic_iter_laws(&it.iter),
+                    IteratorSpec::decrease(&it.iter) is Some,
+                    it.seq() == orig.as_ref(),
+                    collected.len() == it.index(),
+                    forall|i: int| 0 <= i < collected.len()
+                        ==> #[trigger] collected@[i] == *it.seq()[i],
+                decreases IteratorSpec::decrease(&it.iter)->0,
             {
-                if let Some(x) = it.next() {
-                    proof {
-                        items = items.push(*x);
-                    }
-                } else {
-                    break;
+                match it.next() {
+                    Some(x) => { collected.push(*x); },
+                    None => {
+                        assert(collected@ =~= orig);
+                        break;
+                    },
                 }
             }
-            
-            assert(it@.0 == iter_seq.len());
-            assert(items =~= iter_seq);
         }
     } => Ok(())
 }
@@ -53,27 +53,24 @@ test_verify_one_file! {
 test_verify_one_file! {
