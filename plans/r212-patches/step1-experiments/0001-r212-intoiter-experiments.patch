+                vstd::std_specs::slice::into_iter_elts(it) == self.spec_backing_seq(),
+                IteratorSpec::decrease(&it) is Some,
+        {
+            let sl: &[T] = &self.data.as_slice()[self.start..][..self.len];
+            sl.iter()
+        }
+    }
+
+    impl<T> View for SliceS<T> {
+        type V = Seq<T>;
